# ── 1. Groups ─────────────────────────────────────────────────────────────────
clean_groups <- function(df) {
  df %>%
    filter(groupe_delivery %in% c(1, 2, 3)) %>%
    mutate(group = factor(case_when(
      groupe_delivery == 1 ~ "Healthy Control",
      groupe_delivery == 2 ~ "PMD",
      groupe_delivery == 3 ~ "SSRI"
    ), levels = c("Healthy Control", "PMD", "SSRI")))
}

bayley <- clean_groups(bayley)
bitsea <- clean_groups(bitsea)

# ── 2. N labels ───────────────────────────────────────────────────────────────
make_n_labels <- function(df) {
  df %>%
    count(group) %>%
    mutate(label = paste0(as.character(group), "\n(n = ", n, ")"),
           label = factor(label, levels = label))
}

bayley <- bayley %>% left_join(make_n_labels(bayley), by = "group")
bitsea <- bitsea %>% left_join(make_n_labels(bitsea), by = "group")

# ── 3. Colors ─────────────────────────────────────────────────────────────────
group_colors <- c(
  "Healthy Control" = "#4CAF8E",
  "PMD"             = "#7B9EC9",
  "SSRI"            = "#9B7DB5"
)

make_color_map <- function(df) {
  n_lab <- make_n_labels(df %>% select(group) %>% distinct() %>% 
                           left_join(df %>% count(group), by = "group"))
  setNames(
    group_colors[as.character(df %>% 
                                distinct(group, label) %>% 
                                arrange(group) %>% pull(group))],
    df %>% distinct(group, label) %>% arrange(group) %>% pull(label) %>% as.character()
  )
}

bayley_colors <- bayley %>%
  distinct(group, label) %>%
