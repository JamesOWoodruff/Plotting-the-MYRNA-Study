  { setNames(group_colors[as.character(.$group)], as.character(.$label)) }

# ── 4. Plot function (violin + jitter) ───────────────────────────────────────
violin_plot <- function(data, score_col, y_label, title, color_map,
                        ref_line = NULL) {
  
  # n based on non-missing values for this specific score
  plot_data <- data %>% filter(!is.na(.data[[score_col]]))
  
  n_labels <- plot_data %>%
    count(group) %>%
    mutate(label = paste0(as.character(group), "\n(n = ", n, ")"),
           label = factor(label, levels = label))
  
  plot_data <- plot_data %>%
    select(-label) %>%
    left_join(n_labels, by = "group")
  
  # rebuild color map for this score's n labels
  color_map_local <- plot_data %>%
    distinct(group, label) %>%
    arrange(group) %>%
    { setNames(group_colors[as.character(.$group)], as.character(.$label)) }
  
  p <- plot_data %>%
    ggplot(aes(x = label, y = .data[[score_col]], fill = label, color = label)) +
    geom_violin(alpha = 0.3, linewidth = 0.4, trim = TRUE) +
    geom_jitter(width = 0.12, size = 0.8, alpha = 0.5) +
    stat_summary(fun = median, geom = "crossbar", width = 0.4,
                 linewidth = 0.6, color = "black") +
    scale_fill_manual(values  = color_map_local, guide = "none") +
    scale_color_manual(values = color_map_local, guide = "none") +
    labs(title = title, x = NULL, y = y_label) +
    theme_bw(base_size = 11) +
    theme(
      strip.background = element_blank(),
      panel.grid.minor = element_blank(),
      axis.text.x      = element_text(size = 9),
      plot.title       = element_text(face = "bold", size = 11)
    )
  
  if (!is.null(ref_line)) {
    p <- p + geom_hline(yintercept = ref_line, linetype = "dashed",
                        color = "gray40", linewidth = 0.5)
  }
  p
}

