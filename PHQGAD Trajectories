# ── 6. Spaghetti plot function ────────────────────────────────────────────────
# zoom_window: if NULL = full timeline; if c(0, 45) = perinatal zoom
spaghetti_plot <- function(data, score_col, y_label, y_max, color_map,
                           title = NULL, zoom_window = NULL) {
  
  plot_data <- data %>% filter(!is.na(.data[[score_col]]))
  
  if (!is.null(zoom_window)) {
    plot_data <- plot_data %>%
      filter(ga_wk >= zoom_window[1], ga_wk <= zoom_window[2])
  }
  
  p <- plot_data %>%
    ggplot(aes(x = ga_wk, y = .data[[score_col]],
               group = redcap_id, color = label)) +
    geom_line(alpha = 0.2, linewidth = 0.3) +
    geom_smooth(
      aes(group = label),
      method    = "loess",
      se        = FALSE,
      linewidth = 1.2,
      color     = "black"
    ) +
    facet_wrap(~ label, nrow = 1) +
    scale_color_manual(values = color_map, guide = "none") +
    scale_y_continuous(limits = c(0, y_max)) +
    theme_bw(base_size = 11) +
    theme(
      strip.background = element_blank(),
      strip.text       = element_text(face = "bold"),
      panel.grid.minor = element_blank()
    )
  
  # x axis label only on bottom row; strip labels only on top row
  if (!is.null(zoom_window)) {
    p <- p +
      labs(x = "Gestational age (weeks)", y = y_label, title = title) +
      scale_x_continuous(limits = zoom_window)
  } else {
    p <- p +
      labs(x = NULL, y = y_label, title = title) +
      theme(strip.text = element_text(face = "bold"))
  }
  
  p
}

# ── 7. Build per-instrument figures ──────────────────────────────────────────
make_instrument_figure <- function(score_col, y_label, y_max, instrument_title) {
  
  p_full <- spaghetti_plot(
    long_data, score_col, y_label, y_max, color_map,
    title       = "Full timeline",
    zoom_window = NULL
  )
  
  p_zoom <- spaghetti_plot(
    long_data, score_col, y_label, y_max, color_map,
    title       = "Perinatal window (0\u201345 weeks GA)",
    zoom_window = c(0, 45)
  )
  
  (p_full / p_zoom) +
    plot_annotation(
      title = instrument_title,
      theme = theme(
        plot.title = element_text(face = "bold", color = "#2A9D8F", size = 14)
      )
    )
}

