  group_colors[as.character(n_labels$group)],
  as.character(n_labels$label)
)

# ── 6. Plot function ──────────────────────────────────────────────────────────
spaghetti_plot <- function(data, score_col, y_label, y_max, title) {
  data %>%
    filter(!is.na(.data[[score_col]])) %>%
    ggplot(aes(x = ga_wk, y = .data[[score_col]], group = redcap_id, color = label)) +
    geom_line(alpha = 0.2, linewidth = 0.3) +
    geom_smooth(
      aes(group = label),
      method    = "loess",
      se        = FALSE,
      linewidth = 1.2,
      color     = "black"
    ) +
    facet_wrap(~ label, nrow = 1) +
    scale_color_manual(values = color_map, guide = "none") +
    scale_y_continuous(limits = c(0, y_max)) +
    labs(title = title, x = "Gestational age (weeks)", y = y_label) +
    theme_bw(base_size = 11) +
    theme(
      strip.background = element_blank(),
      strip.text       = element_text(face = "bold"),
      panel.grid.minor = element_blank(),
      plot.title       = element_text(face = "bold", color = "#2A9D8F", size = 14)
    )
}

# ── 7. Build and save ─────────────────────────────────────────────────────────
p_phq <- spaghetti_plot(long_data, "phq", "PHQ-9 Sum Score", 27,
                         "Depressive Symptoms (PHQ-9)")
p_gad <- spaghetti_plot(long_data, "gad", "GAD-7 Sum Score", 21,
                         "Anxiety Symptoms (GAD-7)")

p_combined <- p_phq / p_gad

ggsave(file.path(data_dir, "trajectories.png"), 
       p_combined, width = 12, height = 8, dpi = 300)









