bitsea <- read_csv(file.path(data_dir, "Bitsea Data.csv"))

# ── 1. Groups ─────────────────────────────────────────────────────────────────
clean_groups <- function(df) {
  df %>%
    filter(groupe_delivery %in% c(1, 2, 3)) %>%
    mutate(group = factor(case_when(
      groupe_delivery == 1 ~ "Healthy Control",
      groupe_delivery == 2 ~ "PMD",
      groupe_delivery == 3 ~ "SSRI"
    ), levels = c("Healthy Control", "PMD", "SSRI")))
}

bayley <- clean_groups(bayley)
bitsea <- clean_groups(bitsea)

# ── 2. Colors ─────────────────────────────────────────────────────────────────
group_colors <- c(
  "Healthy Control" = "#4CAF8E",
  "PMD"             = "#7B9EC9",
  "SSRI"            = "#9B7DB5"
)

# ── 3. Compute KW + epsilon squared for all five outcomes ─────────────────────
compute_stats <- function(df, score_col, label) {
  dat <- df %>% filter(!is.na(.data[[score_col]]))
  kw  <- kruskal.test(dat[[score_col]] ~ dat$group)
  eps <- round(kw$statistic / (nrow(dat) - 1), 3)
  tibble(
    Outcome   = label,
    H         = round(kw$statistic, 2),
    df        = kw$parameter,
    p         = round(kw$p.value, 3),
    `ε²`      = eps
  )
}

results_table <- bind_rows(
  compute_stats(bayley, "bayley_cog_stan",  "Bayley Cognitive"),
  compute_stats(bayley, "bayley_lang_stan", "Bayley Language"),
  compute_stats(bayley, "bayley_mot_stan",  "Bayley Motor"),
  compute_stats(bitsea, "bitsea_prob",      "BITSEA Problem"),
  compute_stats(bitsea, "bitsea_comp",      "BITSEA Competence")
)

# ── 4. Violin plot function ───────────────────────────────────────────────────
violin_plot <- function(data, score_col, y_label, title, ref_line = NULL) {
  
  plot_data <- data %>% filter(!is.na(.data[[score_col]]))
  
  n_labels <- plot_data %>%
    count(group) %>%
    mutate(label = paste0(as.character(group), "\n(n = ", n, ")"),
           label = factor(label, levels = label))
  
  plot_data <- plot_data %>%
    left_join(n_labels, by = "group")
  
  color_map_local <- plot_data %>%
    distinct(group, label) %>%
    arrange(group) %>%
    { setNames(group_colors[as.character(.$group)], as.character(.$label)) }
  
  p <- plot_data %>%
    ggplot(aes(x = label, y = .data[[score_col]], fill = label, color = label)) +
    geom_violin(alpha = 0.3, linewidth = 0.4, trim = TRUE) +
    geom_jitter(width = 0.12, size = 0.8, alpha = 0.5) +
    stat_summary(fun = median, geom = "crossbar", width = 0.4,
                 linewidth = 0.6, color = "black") +
    scale_fill_manual(values  = color_map_local, guide = "none") +
    scale_color_manual(values = color_map_local, guide = "none") +
    labs(title = title, x = NULL, y = y_label) +
    theme_bw(base_size = 11) +
    theme(
      strip.background = element_blank(),
      panel.grid.minor = element_blank(),
      axis.text.x      = element_text(size = 9),
      plot.title       = element_text(face = "bold", size = 11)
    )
  
  if (!is.null(ref_line)) {
    p <- p + geom_hline(yintercept = ref_line, linetype = "dashed",
                        color = "gray40", linewidth = 0.5)
  }
  p
}

