run_lm_unstd <- function(data, outcome, predictors, label) {
  dat <- data %>%
    select(redcap_id, group, all_of(outcome), all_of(predictors)) %>%
    filter(if_all(everything(), ~ !is.na(.)))

  cat("\n──", label, "(unstandardized)\n")
  cat("N =", nrow(dat),
      "| HC:", sum(dat$group == "Healthy Control"),
      "| PMD:", sum(dat$group == "PMD"),
      "| SSRI:", sum(dat$group == "SSRI"), "\n")

  if (nrow(dat) < 10) { cat("  Insufficient n.\n"); return(invisible(NULL)) }

  m <- lm(reformulate(predictors, response = outcome), data = dat)
  m_sum <- summary(m)

  print(as.data.frame(m_sum$coefficients) %>% round(4) %>% rownames_to_column("term"))
  cat(sprintf("  R\u00b2=%.4f | Adj R\u00b2=%.4f | F(%d,%d)=%.3f | p=%.4f\n",
              m_sum$r.squared, m_sum$adj.r.squared,
              m_sum$fstatistic[2], m_sum$fstatistic[3],
              m_sum$fstatistic[1],
              pf(m_sum$fstatistic[1], m_sum$fstatistic[2],
                 m_sum$fstatistic[3], lower.tail = FALSE)))

  if (length(predictors) > 1) {
    vif_vals <- vif(m)
    print(data.frame(
      term = names(vif_vals), VIF = round(vif_vals, 3),
      flag = ifelse(vif_vals > 5, "HIGH", ifelse(vif_vals > 2.5, "moderate", "ok"))
    ))
  }
  invisible(m)
}

run_lm_std <- function(data, outcome, predictors) {
  dat <- data %>%
    select(redcap_id, group, all_of(outcome), all_of(predictors)) %>%
    filter(if_all(everything(), ~ !is.na(.)))
  if (nrow(dat) < 10) return(invisible(NULL))
  dat_scaled <- dat %>%
    mutate(across(c(all_of(outcome), all_of(predictors)), ~ as.numeric(scale(.))))
  invisible(lm(reformulate(predictors, response = outcome), data = dat_scaled))
}

