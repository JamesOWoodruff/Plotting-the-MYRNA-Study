# ── 12. Helpers ───────────────────────────────────────────────────────────────
is_sig <- function(model, term) {
  if (is.null(model)) return(FALSE)
  coefs <- summary(model)$coefficients
  if (!term %in% rownames(coefs)) return(FALSE)
  coefs[term, "Pr(>|t|)"] < 0.05
}

get_std_beta <- function(std_model, term) {
  if (is.null(std_model)) return("")
  coefs <- summary(std_model)$coefficients
  if (!term %in% rownames(coefs)) return("")
  b <- round(coefs[term, "Estimate"], 2)
  paste0("\u03b2=", b, "*")
}

get_xy <- function(id, col, nodes) nodes %>% filter(id == !!id) %>% pull(!!col)

make_edge <- function(from, to, unstd_model, std_model, term, model_label, nodes) {
  sig  <- is_sig(unstd_model, term)
  beta <- if (sig) get_std_beta(std_model, term) else ""
  tibble(
    x1 = get_xy(from, "x", nodes), y1 = get_xy(from, "y", nodes),
    x2 = get_xy(to,   "x", nodes), y2 = get_xy(to,   "y", nodes),
    sig = sig, beta = beta, mlabel = model_label,
    full_label = if_else(sig, paste0(model_label, ": ", beta), "")
  ) %>% mutate(lx = (x1 + x2) / 2, ly = (y1 + y2) / 2)
}

# ── 13. Path diagram builder ──────────────────────────────────────────────────
build_path <- function(m0_u, m0_s, m1_u, m1_s, m2_u, m2_s,
                       m3a_u, m3a_s, m3b_u, m3b_s, m3c_u, m3c_s,
                       has_dose = FALSE, title_suffix = "") {

  nodes <- tribble(
    ~id,       ~x,    ~y,   ~label,         ~sublabel,
    "t1t2",    1.6,   5.5,  "T1-T2 PHQ",    "(0-26 wk)",
    "t3",      2.4,   2.5,  "T3 PHQ",       "(27-40 wk)",
    "ip",      4.2,   5.5,  "IP PHQ",       "(40-46 wk)",
    "postp",   6.0,   4.0,  "Postp PHQ",    "(46+ wk)",
    "cog",     8.2,   6.5,  "Bayley",       "Cognitive",
    "prob",    8.2,   4.0,  "BITSEA",       "Problem",
    "comp",    8.2,   1.5,  "BITSEA",       "Competence"
  )

  if (has_dose) {
    nodes <- bind_rows(
      tibble(id = "dt1t2", x = 0.2, y = 5.8, label = "Dose T1\u2013T2", sublabel = "(0-26 wk)"),
      tibble(id = "dt3",   x = 0.2, y = 2.2, label = "Dose T3",        sublabel = "(27-40 wk)"),
      nodes
    )
  }

edges <- bind_rows(
    make_edge("t1t2", "t3",    m0_u,  m0_s,  "phq_t1t2",  "M0",  nodes),
    make_edge("t1t2", "ip",    m1_u,  m1_s,  "phq_t1t2",  "M1",  nodes),
    make_edge("t3",   "ip",    m1_u,  m1_s,  "phq_t3",    "M1",  nodes),
    make_edge("t1t2", "postp", m2_u,  m2_s,  "phq_t1t2",  "M2",  nodes),
    make_edge("t3",   "postp", m2_u,  m2_s,  "phq_t3",    "M2",  nodes),
    make_edge("ip",   "postp", m2_u,  m2_s,  "phq_ip",    "M2",  nodes),
    make_edge("t1t2", "cog",   m3a_u, m3a_s, "phq_t1t2",  "M3a", nodes),
    make_edge("t3",   "cog",   m3a_u, m3a_s, "phq_t3",    "M3a", nodes),
    make_edge("ip",   "cog",   m3a_u, m3a_s, "phq_ip",    "M3a", nodes),
    make_edge("postp","cog",   m3a_u, m3a_s, "phq_postp", "M3a", nodes),
    make_edge("t1t2", "prob",  m3b_u, m3b_s, "phq_t1t2",  "M3b", nodes),
    make_edge("t3",   "prob",  m3b_u, m3b_s, "phq_t3",    "M3b", nodes),
    make_edge("ip",   "prob",  m3b_u, m3b_s, "phq_ip",    "M3b", nodes),
    make_edge("postp","prob",  m3b_u, m3b_s, "phq_postp", "M3b", nodes),
    make_edge("t1t2", "comp",  m3c_u, m3c_s, "phq_t1t2",  "M3c", nodes),
    make_edge("t3",   "comp",  m3c_u, m3c_s, "phq_t3",    "M3c", nodes),
    make_edge("ip",   "comp",  m3c_u, m3c_s, "phq_ip",    "M3c", nodes),
    make_edge("postp","comp",  m3c_u, m3c_s, "phq_postp", "M3c", nodes)
  ) %>% mutate(path_type = "phq")

  if (has_dose) {
    dose_edges <- bind_rows(
      make_edge("dt1t2", "t3",    m0_u,  m0_s,  "ssri_dose_t1t2", "M0",  nodes),
      make_edge("dt1t2", "ip",    m1_u,  m1_s,  "ssri_dose_t1t2", "M1",  nodes),
      make_edge("dt3",   "ip",    m1_u,  m1_s,  "ssri_dose_t3",   "M1",  nodes),
      make_edge("dt1t2", "postp", m2_u,  m2_s,  "ssri_dose_t1t2", "M2",  nodes),
      make_edge("dt3",   "postp", m2_u,  m2_s,  "ssri_dose_t3",   "M2",  nodes),
      make_edge("dt1t2", "cog",   m3a_u, m3a_s, "ssri_dose_t1t2", "M3a", nodes),
      make_edge("dt3",   "cog",   m3a_u, m3a_s, "ssri_dose_t3",   "M3a", nodes),
      make_edge("dt1t2", "prob",  m3b_u, m3b_s, "ssri_dose_t1t2", "M3b", nodes),
      make_edge("dt3",   "prob",  m3b_u, m3b_s, "ssri_dose_t3",   "M3b", nodes),
      make_edge("dt1t2", "comp",  m3c_u, m3c_s, "ssri_dose_t1t2", "M3c", nodes),
      make_edge("dt3",   "comp",  m3c_u, m3c_s, "ssri_dose_t3",   "M3c", nodes)
    ) %>% mutate(path_type = "dose")
    edges <- bind_rows(edges, dose_edges)
  }

  # offset beta label y-positions by path type to prevent overlap
  edges <- edges %>%
    mutate(
      ly_offset = case_when(
        path_type == "phq"  ~  ly + 0.25,
        path_type == "dose" ~  ly - 0.25,
        TRUE                ~  ly
      )
    )

  xlim_lo <- if (has_dose) -0.6 else 1.0
  dividers <- if (has_dose) c(1.1, 3.2, 5.1, 7.2) else c(3.2, 5.1, 7.2)
  col_x    <- if (has_dose) c(0.2, 2.0, 4.2, 6.0, 8.2) else c(2.0, 4.2, 6.0, 8.2)
  col_labs <- if (has_dose) c("SSRI\nDose", "Prenatal", "Immediate\nPostpartum",
                               "Late\nPostpartum", "Offspring\n24 months") else
                            c("Prenatal", "Immediate\nPostpartum",
                              "Late\nPostpartum", "Offspring\n24 months")

  p <- ggplot() +
    geom_segment(data = edges %>% filter(!sig),
                 aes(x = x1, y = y1, xend = x2, yend = y2),
                 color = "gray80", linewidth = 0.4,
                 arrow = arrow(length = unit(0.2, "cm"), type = "closed")) +
    geom_segment(data = edges %>% filter(sig),
                 aes(x = x1, y = y1, xend = x2, yend = y2),
                 color = "#2A9D8F", linewidth = 1.0,
                 arrow = arrow(length = unit(0.22, "cm"), type = "closed")) +
    geom_label(data = edges %>% filter(sig),
               aes(x = lx, y = ly, label = full_label),
               size = 4.2, fill = "white", color = "#1A6B63",
               label.size = 0.2, fontface = "bold",
               label.padding = unit(0.25, "lines")) +
    geom_label(data = nodes %>% filter(!id %in% c("dt1t2", "dt3")),
               aes(x = x, y = y, label = paste0(label, "\n", sublabel)),
               size = 4.2, fill = "#E8F5F3", color = "#1A6B63",
               label.size = 0.5, fontface = "bold",
               label.padding = unit(0.4, "lines")) +
    geom_vline(xintercept = dividers,
               linetype = "dashed", color = "gray75", linewidth = 0.35)

  if (has_dose) {
    p <- p + geom_label(
      data = nodes %>% filter(id %in% c("dt1t2", "dt3")),
      aes(x = x, y = y, label = paste0(label, "\n", sublabel)),
      size = 4.0, fill = "#FFF3CD", color = "#1A6B63",
      label.size = 0.5, fontface = "bold",
      label.padding = unit(0.4, "lines")
    )
  }

  for (i in seq_along(col_x)) {
    p <- p + annotate("text", x = col_x[i], y = 7.8,
                      label = col_labs[i],
                      size = 4.5, color = "black", fontface = "bold")
  }

  p +
    scale_x_continuous(limits = c(xlim_lo, 9.2), expand = c(0, 0)) +
    scale_y_continuous(limits = c(0.8, 8.5),      expand = c(0, 0)) +
    labs(
      title    = paste0("Sequential PHQ Prediction Model \u2014 ", title_suffix),
      subtitle = "Teal = significant (p<0.05); gray = non-significant\nStandardized \u03b2 from separate sequential OLS models (M0\u2013M3); * p < 0.05"
    ) +
    theme_void(base_size = 13) +
    theme(
      plot.background = element_rect(fill = "white", color = NA),
      plot.title      = element_text(face = "bold", color = "#2A9D8F", size = 15,
                                     margin = margin(b = 5)),
      plot.subtitle   = element_text(color = "black", size = 10,
                                     margin = margin(b = 8)),
      plot.margin     = margin(10, 5, 10, 5)
    )
}

