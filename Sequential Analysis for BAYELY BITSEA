# ── 6. Regression + VIF function ─────────────────────────────────────────────
run_model_vif <- function(data, outcome_col, predictors, model_label, outcome_label) {

  dat <- data %>%
    select(redcap_id, group, all_of(outcome_col), all_of(predictors)) %>%
    filter(if_all(everything(), ~ !is.na(.)))

  cat("\n── ", model_label, " | Outcome: ", outcome_label, " ──\n", sep = "")
  cat("N =", nrow(dat),
      "| HC:", sum(dat$group == "Healthy Control"),
      "| PMD:", sum(dat$group == "PMD"),
      "| SSRI:", sum(dat$group == "SSRI"), "\n")

  if (nrow(dat) < 10) {
    cat("  Insufficient n — skipping.\n")
    return(invisible(NULL))
  }

  formula <- reformulate(predictors, response = outcome_col)
  m <- lm(formula, data = dat)
  m_sum <- summary(m)

  coef_df <- as.data.frame(m_sum$coefficients) %>%
    round(4) %>%
    rownames_to_column("term")
  print(coef_df)

  cat(sprintf("  R² = %.4f | Adj R² = %.4f | F(%d,%d) = %.3f | p = %.4f\n",
              m_sum$r.squared, m_sum$adj.r.squared,
              m_sum$fstatistic[2], m_sum$fstatistic[3],
              m_sum$fstatistic[1],
              pf(m_sum$fstatistic[1], m_sum$fstatistic[2],
                 m_sum$fstatistic[3], lower.tail = FALSE)))

  if (length(predictors) > 1) {
    cat("\nVIF:\n")
    vif_vals <- vif(m)
    vif_df <- data.frame(
      term = names(vif_vals),
      VIF  = round(vif_vals, 3),
      flag = ifelse(vif_vals > 5, ">> HIGH <<", ifelse(vif_vals > 2.5, "moderate", "ok"))
    )
    print(vif_df)
  }

  invisible(m)
}

