# ── 15. Helpers ───────────────────────────────────────────────────────────────
is_sig <- function(model, term) {
  if (is.null(model)) return(FALSE)
  coefs <- summary(model)$coefficients
  if (!term %in% rownames(coefs)) return(FALSE)
  coefs[term, "Pr(>|t|)"] < 0.05
}

get_std_beta <- function(std_model, term) {
  if (is.null(std_model)) return("")
  coefs <- summary(std_model)$coefficients
  if (!term %in% rownames(coefs)) return("")
  b <- round(coefs[term, "Estimate"], 2)
  paste0("\u03b2=", b, "*")
}

get_xy <- function(id, col, nodes) nodes %>% filter(id == !!id) %>% pull(!!col)

make_edge <- function(from, to, unstd_model, std_model, term, model_label, nodes) {
  sig  <- is_sig(unstd_model, term)
  beta <- if (sig) get_std_beta(std_model, term) else ""
  tibble(
    x1 = get_xy(from, "x", nodes), y1 = get_xy(from, "y", nodes),
    x2 = get_xy(to,   "x", nodes), y2 = get_xy(to,   "y", nodes),
    sig = sig, beta = beta, mlabel = model_label,
    full_label = if_else(sig, paste0(model_label, ": ", beta), "")
  ) %>% mutate(lx = (x1 + x2) / 2, ly = (y1 + y2) / 2)
}

# ── 16. Path diagram builder — full outcome set ───────────────────────────────
build_path_full <- function(
    m0_u, m0_s_arg, m1_u, m1_s_arg, m2_u, m2_s_arg,
    m3a_u, m3a_s_arg, m3b_u, m3b_s_arg, m3c_u, m3c_s_arg,
    m3d_u, m3d_s_arg, m3e_u, m3e_s_arg,
    m3f_u, m3f_s_arg, m3g_u, m3g_s_arg, m3h_u, m3h_s_arg,
    has_dose = FALSE, title_suffix = "") {

  nodes <- tribble(
    ~id,      ~x,    ~y,    ~label,          ~sublabel,
    "t1t2",   1.6,   6.5,   "T1-T2 PHQ",     "(0-26 wk)",
    "t3",     2.4,   1.5,   "T3 PHQ",        "(27-40 wk)",
    "ip",     4.2,   6.5,   "IP PHQ",        "(40-46 wk)",
    "postp",  6.0,   4.0,   "Postp PHQ",     "(46+ wk)",
    "cog",    8.2,   7.8,   "Bayley",        "Cognitive",
    "prob",   8.2,   6.4,   "BITSEA",        "Problem",
    "comp",   8.2,   5.0,   "BITSEA",        "Competence",
    "act",    8.2,   3.6,   "Activity",      "Level",
    "plais",  8.2,   2.4,   "Pleasure",      "",
    "fear",   8.2,   1.2,   "Social",        "Fearfulness",
    "anger",  8.2,   0.0,   "Anger",         "",
    "int",    8.2,  -1.2,   "Interest /",    "Attention"
  )

  if (has_dose) {
    nodes <- bind_rows(
      tibble(id = "dt1t2", x = 0.2, y = 5.5,
             label = "Dose T1\u2013T2", sublabel = "(0-26 wk)"),
      tibble(id = "dt3",   x = 0.2, y = 2.5,
             label = "Dose T3",         sublabel = "(27-40 wk)"),
      nodes
    )
  }

  phq_edges <- bind_rows(
    make_edge("t1t2", "t3",    m0_u,  m0_s_arg,  "phq_t1t2",  "M0",  nodes),
    make_edge("t1t2", "ip",    m1_u,  m1_s_arg,  "phq_t1t2",  "M1",  nodes),
    make_edge("t3",   "ip",    m1_u,  m1_s_arg,  "phq_t3",    "M1",  nodes),
    make_edge("t1t2", "postp", m2_u,  m2_s_arg,  "phq_t1t2",  "M2",  nodes),
    make_edge("t3",   "postp", m2_u,  m2_s_arg,  "phq_t3",    "M2",  nodes),
    make_edge("ip",   "postp", m2_u,  m2_s_arg,  "phq_ip",    "M2",  nodes),
    make_edge("t1t2", "cog",   m3a_u, m3a_s_arg, "phq_t1t2",  "M3a", nodes),
    make_edge("t3",   "cog",   m3a_u, m3a_s_arg, "phq_t3",    "M3a", nodes),
    make_edge("ip",   "cog",   m3a_u, m3a_s_arg, "phq_ip",    "M3a", nodes),
