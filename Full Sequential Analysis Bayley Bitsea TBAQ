    make_edge("ip",   "prob",  m3b_u, m3b_s_arg, "phq_ip",    "M3b", nodes),
    make_edge("postp","prob",  m3b_u, m3b_s_arg, "phq_postp", "M3b", nodes),
    make_edge("t1t2", "comp",  m3c_u, m3c_s_arg, "phq_t1t2",  "M3c", nodes),
    make_edge("t3",   "comp",  m3c_u, m3c_s_arg, "phq_t3",    "M3c", nodes),
    make_edge("ip",   "comp",  m3c_u, m3c_s_arg, "phq_ip",    "M3c", nodes),
    make_edge("postp","comp",  m3c_u, m3c_s_arg, "phq_postp", "M3c", nodes),
    make_edge("t1t2", "act",   m3d_u, m3d_s_arg, "phq_t1t2",  "M3d", nodes),
    make_edge("t3",   "act",   m3d_u, m3d_s_arg, "phq_t3",    "M3d", nodes),
    make_edge("ip",   "act",   m3d_u, m3d_s_arg, "phq_ip",    "M3d", nodes),
    make_edge("postp","act",   m3d_u, m3d_s_arg, "phq_postp", "M3d", nodes),
    make_edge("t1t2", "plais", m3e_u, m3e_s_arg, "phq_t1t2",  "M3e", nodes),
    make_edge("t3",   "plais", m3e_u, m3e_s_arg, "phq_t3",    "M3e", nodes),
    make_edge("ip",   "plais", m3e_u, m3e_s_arg, "phq_ip",    "M3e", nodes),
    make_edge("postp","plais", m3e_u, m3e_s_arg, "phq_postp", "M3e", nodes),
    make_edge("t1t2", "fear",  m3f_u, m3f_s_arg, "phq_t1t2",  "M3f", nodes),
    make_edge("t3",   "fear",  m3f_u, m3f_s_arg, "phq_t3",    "M3f", nodes),
    make_edge("ip",   "fear",  m3f_u, m3f_s_arg, "phq_ip",    "M3f", nodes),
    make_edge("postp","fear",  m3f_u, m3f_s_arg, "phq_postp", "M3f", nodes),
    make_edge("t1t2", "anger", m3g_u, m3g_s_arg, "phq_t1t2",  "M3g", nodes),
    make_edge("t3",   "anger", m3g_u, m3g_s_arg, "phq_t3",    "M3g", nodes),
    make_edge("ip",   "anger", m3g_u, m3g_s_arg, "phq_ip",    "M3g", nodes),
    make_edge("postp","anger", m3g_u, m3g_s_arg, "phq_postp", "M3g", nodes),
    make_edge("t1t2", "int",   m3h_u, m3h_s_arg, "phq_t1t2",  "M3h", nodes),
    make_edge("t3",   "int",   m3h_u, m3h_s_arg, "phq_t3",    "M3h", nodes),
    make_edge("ip",   "int",   m3h_u, m3h_s_arg, "phq_ip",    "M3h", nodes),
    make_edge("postp","int",   m3h_u, m3h_s_arg, "phq_postp", "M3h", nodes)
  ) %>% mutate(path_type = "phq")

  edges <- phq_edges

  if (has_dose) {
    dose_edges <- bind_rows(
      make_edge("dt1t2","t3",    m0_u,  m0_s_arg,  "ssri_dose_t1t2","M0",  nodes),
      make_edge("dt1t2","ip",    m1_u,  m1_s_arg,  "ssri_dose_t1t2","M1",  nodes),
      make_edge("dt3",  "ip",    m1_u,  m1_s_arg,  "ssri_dose_t3",  "M1",  nodes),
      make_edge("dt1t2","postp", m2_u,  m2_s_arg,  "ssri_dose_t1t2","M2",  nodes),
      make_edge("dt3",  "postp", m2_u,  m2_s_arg,  "ssri_dose_t3",  "M2",  nodes),
      make_edge("dt1t2","cog",   m3a_u, m3a_s_arg, "ssri_dose_t1t2","M3a", nodes),
      make_edge("dt3",  "cog",   m3a_u, m3a_s_arg, "ssri_dose_t3",  "M3a", nodes),
      make_edge("dt1t2","prob",  m3b_u, m3b_s_arg, "ssri_dose_t1t2","M3b", nodes),
