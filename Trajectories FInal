# ── 5. Spaghetti plot function ────────────────────────────────────────────────
spaghetti_plot <- function(data, score_col, y_label, y_max,
                           row_title, zoom_window = NULL,
                           show_delivery_line = FALSE) {
  
  plot_data <- data %>% filter(!is.na(.data[[score_col]]))
  
  if (!is.null(zoom_window)) {
    plot_data <- plot_data %>%
      filter(ga_wk >= zoom_window[1], ga_wk <= zoom_window[2])
  }
  
  # n based on non-missing within window
  n_labels <- plot_data %>%
    distinct(redcap_id, group) %>%
    count(group) %>%
    mutate(label = paste0(as.character(group), "\n(n = ", n, ")"),
           label = factor(label, levels = label))
  
  plot_data <- plot_data %>%
    left_join(n_labels, by = "group")
  
  color_map <- plot_data %>%
    distinct(group, label) %>%
    arrange(group) %>%
    { setNames(group_colors[as.character(.$group)], as.character(.$label)) }
  
  p <- plot_data %>%
    ggplot(aes(x = ga_wk, y = .data[[score_col]],
               group = redcap_id, color = label)) +
    geom_line(alpha = 0.2, linewidth = 0.3) +
    geom_smooth(
      aes(group = label),
      method    = "loess",
      se        = FALSE,
      linewidth = 1.2,
      color     = "black"
    ) +
    facet_wrap(~ label, nrow = 1) +
    scale_color_manual(values = color_map, guide = "none") +
    scale_y_continuous(limits = c(0, y_max)) +
    labs(title = row_title, x = "Gestational age (weeks)", y = y_label) +
 # Inside spaghetti_plot — replace the theme() block
  theme_bw(base_size = 16) +
  theme(
    strip.background = element_blank(),
    strip.text       = element_text(face = "bold", size = 16),
    panel.grid.minor = element_blank(),
    plot.title       = element_text(face = "bold", size = 15, color = "gray30"),
    axis.title       = element_text(size = 14),
    axis.text        = element_text(size = 13)
  )
  
  if (!is.null(zoom_window)) {
    p <- p + scale_x_continuous(
      limits = zoom_window,
      breaks = seq(zoom_window[1], zoom_window[2], by = 5)
    )
  }
  
  if (show_delivery_line) {
    p <- p +
      geom_vline(xintercept = 40, linetype = "dashed",
                 color = "gray40", linewidth = 0.4) +
      annotate("text", x = 40.5, y = y_max * 0.97,
               label = "Term (40 wk)", hjust = 0, size = 3, color = "gray40")
  }
  
  p
}

# ── 6. Build per-instrument figures ──────────────────────────────────────────
make_figure <- function(score_col, y_label, y_max, instrument_title, filename) {
  
  p_full <- spaghetti_plot(long_data, score_col, y_label, y_max,
                            row_title = "Full Timeline")
  
  p_preg <- spaghetti_plot(long_data, score_col, y_label, y_max,
                            row_title      = "Pregnancy Window (0\u201345 weeks GA)",
                            zoom_window    = c(0, 45))
  
  p_deliv <- spaghetti_plot(long_data, score_col, y_label, y_max,
                             row_title          = "Delivery Window (30\u201350 weeks GA)",
                             zoom_window        = c(30, 50),
                             show_delivery_line = TRUE)
  
  p_combined <- (p_full / p_preg / p_deliv) +
    plot_layout(heights = c(1, 1, 1)) +
  plot_annotation(
    title = instrument_title,
    theme = theme(
      plot.title = element_text(face = "bold", color = "#2A9D8F", size = 22)
    )
  )
  
ggsave(file.path(data_dir, filename),
         p_combined, width = 14, height = 16, dpi = 300)
  
  message("Saved: ", filename)
}

